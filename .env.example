# Copy to .env (remote) or use env files below:
#
#   npm run dev          → no Supabase (localStorage only)
#   npm run dev:local    → local Supabase via .env.local (auto-filled)
#   npm run dev:remote   → remote Supabase via .env.remote (fill in your values)
#
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
